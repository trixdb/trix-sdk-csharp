<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Metadata -->
    <PackageId>Trix</PackageId>
    <Version>0.6.0</Version>
    <Authors>Trix Team</Authors>
    <Company>Trix</Company>
    <Product>Trix SDK for .NET</Product>
    <Description>Official .NET SDK for Trix - A memory and knowledge management API</Description>
    <PackageTags>trix;memory;knowledge;graph;api;sdk</PackageTags>
    <PackageProjectUrl>https://github.com/trixdb/trix-sdk-csharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/trixdb/trix-sdk-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) Trix 2025</Copyright>

    <!-- Build Settings -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Guard against regressing XML-doc completeness (CS1573) and stray member
         hiding (CS0109) so the public API stays clean without downstream workarounds. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1573;CS0109</WarningsAsErrors>

    <!-- Assembly Info -->
    <AssemblyName>Trix</AssemblyName>
    <RootNamespace>Trix</RootNamespace>


    <!-- SourceLink for better debugging -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Deterministic builds for reproducibility -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- .NET settings -->
  <PropertyGroup>
    <!-- AOT requires source generators for JSON - disabled for now -->
    <IsTrimmable>false</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- Expose internals to test project -->
  <ItemGroup>
    <InternalsVisibleTo Include="Trix.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
